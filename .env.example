# 复制此文件为 .env 并填入配置（.env 优先级高于环境变量和 Web 设置页保存的 config.json）
# 配置优先级：请求参数 > .env > 环境变量 > config.json > 默认值

# ---- Provider 选择：deepseek(默认) / openai / anthropic / ollama ----
CRV_PROVIDER=deepseek

# ---- DeepSeek（推荐，platform.deepseek.com 获取 Key）----
CRV_DEEPSEEK_API_KEY=
CRV_DEEPSEEK_API_BASE=https://api.deepseek.com/v1
CRV_DEEPSEEK_MODEL=deepseek-chat

# ---- OpenAI 兼容服务 ----
# CRV_OPENAI_API_KEY=
# CRV_OPENAI_API_BASE=https://api.openai.com/v1
# CRV_OPENAI_MODEL=gpt-4o-mini

# ---- Anthropic 兼容服务 ----
# CRV_ANTHROPIC_API_KEY=
# CRV_ANTHROPIC_API_BASE=https://api.anthropic.com
# CRV_ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ---- Ollama 本地模型（无需 Key）----
# CRV_OLLAMA_HOST=http://127.0.0.1:11434
# CRV_OLLAMA_MODEL=qwen2.5-coder:7b

# ---- 服务与审查参数 ----
# CRV_PORT=3000
# CRV_TEMPERATURE=0.3
# CRV_MAX_TOKENS=4096
# CRV_TIMEOUT_MS=120000
# CRV_REVIEW_MODE=single      # single(默认) / multi(多 Agent 协作)

# ---- 知识库 / RAG ----
# CRV_KB_ENABLED=false
# CRV_KB_COLLECTION=aicr_kb
# CRV_KB_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# CRV_KB_TOP_K=5
# CRV_KB_CHUNK_SIZE=800
# CRV_KB_CHUNK_OVERLAP=100
# 远程 Qdrant 服务（留空则使用本地内嵌，无需 Docker）
# CRV_KB_QDRANT_URL=
# CRV_KB_QDRANT_API_KEY=
# CRV_KB_QDRANT_PATH=data/kb

# HuggingFace 模型下载镜像（国内网络必需，否则无法拉取 embedding 模型）
# HF_ENDPOINT=https://hf-mirror.com

# 额外需要脱敏的环境变量名（逗号分隔），不出现在任何日志/工件中
# CRV_SECRET_ENV_NAMES=
